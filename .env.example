# LGNDRY.Co Studio Desk: environment variables.
# This file contains PLACEHOLDERS ONLY. Never commit real values. Copy to apps/studio/.env.local.

# --- Mode -------------------------------------------------------------------
# "true" shows clearly marked fictional records and disables every live provider.
DEMO_MODE=true

# --- Supabase (Phase 2) -------------------------------------------------------
# Both are PUBLIC values (Project Settings > API). With them set, the studio requires staff sign-in.
# Leave them unset to keep the demo (no sign-in).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "anon" or "publishable" key. Safe in the browser. NEVER put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Phase 4): provider is not selected yet --------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# --- Email (Phase 4/6): provider is not selected yet ---------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=
