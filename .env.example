# LGNDRY.Co website: environment variables. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local work; set the same names in the Vercel project for the live site.

# Where the catalogue comes from.
#   database -> the Studio Desk database (works, collections, page pictures)
#   anything else, or unset -> the built-in prototype catalogue (the site as it was)
CATALOGUE_SOURCE=

# PUBLIC values from Supabase (Project Settings > API). Safe in the browser: the anon key can read the
# read-only storefront views and nothing else. NEVER put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. A long random string. Lets the Studio Desk refresh the site the moment a work is published.
# With it unset, /api/revalidate is switched off and changes appear within five minutes.
REVALIDATE_SECRET=
